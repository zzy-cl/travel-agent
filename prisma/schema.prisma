generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String   @id @default(cuid())
  preferences String   @default("{}")  // JSON string of UserPreferences
  trips       Trip[]
  createdAt   DateTime @default(now())
}

model Trip {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  planMarkdown  String
  collectedInfo String   @default("{}")  // JSON string of CollectedInfo
  status        String   @default("planning")  // planning | ongoing | completed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
