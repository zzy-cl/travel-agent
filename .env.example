# ── LLM Configuration ──
# Required: Your API key for DeepSeek (or compatible Anthropic API)
ANTHROPIC_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: API base URL (default: https://api.deepseek.com/anthropic)
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Optional: Model name (default: deepseek-v4-pro)
# LLM_MODEL=deepseek-v4-pro

# Optional: Enable/disable thinking mode (default: enabled)
# Set to "false" to disable thinking for faster responses
# LLM_THINKING=enabled

# ── External Services ──
# Optional: SearXNG search instance URL (default: https://searxng.zhaozeyu.top)
# For production, host your own instance or use a trusted provider
# SEARXNG_BASE_URL=https://your-searxng-instance.example.com

# Optional: QWeather (和风天气) API key for weather queries
# Get one at: https://dev.qweather.com/
# QWEATHER_API_KEY=your_qweather_api_key

# ── State Persistence ──
# Optional: Checkpointer backend for LangGraph state (default: memory)
# Options: memory (dev only), postgres, redis
# For Vercel production, use postgres or redis to persist conversation state
# CHECKPOINTER_BACKEND=memory
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# REDIS_URL=redis://default:pass@host:6379
